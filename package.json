{
  "name": "mindfield-muse-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "JavaScript tools for Muse EEG data quality, headband fit checks, OSC packet-loss tracking and experimental neurofeedback games.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./sensor-validity": "./src/sensor-validity.mjs",
    "./fit-window": "./src/fit-window.mjs",
    "./seq-tracker": "./src/seq-tracker.mjs",
    "./game-signal": "./src/game-signal.mjs"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node examples/synthetic-session.mjs",
    "check": "npm test && npm run demo"
  },
  "files": [
    "src/",
    "docs/",
    "FIELD-NOTES.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eeg",
    "muse",
    "javascript",
    "neurofeedback",
    "signal-processing",
    "osc",
    "biosignals",
    "packet-loss",
    "synthetic-data"
  ],
  "homepage": "https://corbett.vc/mindfield/",
  "repository": {
    "type": "git",
    "url": "https://github.com/corbett3000/mindfield-muse-toolkit.git"
  }
}
